{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "protocol": {
      "type": "string",
      "const": "jarvis"
    },
    "protocol_version": {
      "type": "string",
      "const": "v0.1"
    },
    "protocol_commit": {
      "type": "string"
    },
    "suite_version": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number"
    },
    "target": {
      "type": "string",
      "maxLength": 2048
    },
    "config": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "commit": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "unauthorized_actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "human_worker_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "agent_worker_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "auth_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,100}$"
        }
      },
      "required": [
        "implementation",
        "actor_id",
        "unauthorized_actor_id",
        "human_worker_id",
        "agent_worker_id",
        "policy_id",
        "auth_env"
      ],
      "additionalProperties": false
    },
    "selected_tests": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "definition": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z]+-\\d{3}$"
              },
              "version": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "requirement": {
                "type": "string"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "expected": {
                "type": "string"
              },
              "setup": {
                "type": "string"
              },
              "reproduction": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "possible_causes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "version",
              "name",
              "category",
              "purpose",
              "requirement",
              "references",
              "expected",
              "setup",
              "reproduction",
              "possible_causes"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "inconclusive"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "duration_ms": {
            "type": "number"
          },
          "exchanges": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "timestamp": {
                  "type": "string"
                },
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "method": {
                      "type": "string",
                      "enum": [
                        "GET",
                        "POST"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "headers": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "body": {}
                  },
                  "required": [
                    "method",
                    "path",
                    "headers"
                  ],
                  "additionalProperties": false
                },
                "response": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "headers": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "body": {},
                    "normalized": {}
                  },
                  "required": [
                    "status",
                    "headers",
                    "body",
                    "normalized"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "sequence",
                "timestamp",
                "duration_ms",
                "request"
              ],
              "additionalProperties": false
            }
          },
          "diagnostic": {
            "type": "object",
            "properties": {
              "failure_code": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "medium",
                  "high"
                ]
              },
              "category": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "protocol_requirement": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "reproduction": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "possible_causes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "limited"
                ]
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "failure_code",
              "severity",
              "category",
              "expected",
              "observed",
              "protocol_requirement",
              "evidence",
              "reproduction",
              "possible_causes",
              "confidence",
              "references"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "definition",
          "status",
          "started_at",
          "finished_at",
          "duration_ms",
          "exchanges",
          "diagnostic"
        ],
        "additionalProperties": false
      }
    },
    "notice": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replay_of": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "protocol",
    "protocol_version",
    "protocol_commit",
    "suite_version",
    "started_at",
    "finished_at",
    "duration_ms",
    "target",
    "config",
    "selected_tests",
    "results",
    "notice",
    "limitations"
  ],
  "additionalProperties": false
}
