{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "suites/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "examples/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".research"]
}
